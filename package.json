{
  "version": "3.0.8",
  "license": "AGPL-3.0-or-later",
  "name": "@constl/utils-ipa",
  "author": "Julien Jean Malard-Adam",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "nettoyer": "rimraf dist",
    "compiler": "pnpm versioner && pnpm nettoyer && pnpm tspc -p tsconfig.json",
    "compiler:prod": "pnpm versioner && pnpm nettoyer && pnpm tspc -p tsconfig.build.json",
    "test:node": "pnpm compiler && pnpm aegir test -t node -f \"dist/test/**/*.spec.js\" --cov",
    "test:navig": "pnpm compiler && pnpm aegir test -t browser -f \"dist/test/**/*.spec.js\" --cov",
    "test:électron-principal": "pnpm compiler && pnpm aegir test -t electron-main -f \"dist/test/**/*.spec.js\" --cov",
    "test:électron-rendu": "pnpm compiler && pnpm aegir test -t electron-renderer -f \"dist/test/**/*.spec.js\" --cov",
    "test": "pnpm test:node && pnpm test:navig",
    "formatter": "pnpm prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\" && pnpm eslint --ext .js,.ts src",
    "publier": "pnpm test && pnpm compiler:prod && (git commit -a -m 'version' || true) && pnpm publish",
    "versioner": "pnpm genversion  --es6 --semi src/version.ts"
  },
  "watch": {
    "build": {
      "patterns": "./src/**/*",
      "extensions": [
        ".ts",
        ".tsx"
      ]
    },
    "postbuild": "./dist/**/*"
  },
  "devDependencies": {
    "@chriscdn/promise-semaphore": "^4.0.0",
    "@constl/ipa": "^1.6.24",
    "@constl/utils-tests": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@libp2p/interface": "^3.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/geojson-validation": "^1.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "aegir": "^48.1.5",
    "core-js": "^3.50.0",
    "eslint": "^10.9.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.0",
    "eslint-plugin-promise": "^7.3.0",
    "mocha": "^11.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "ts-patch": "^4.0.1",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "typescript-transform-paths": "^4.0.0"
  },
  "dependencies": {
    "browser-fs-access": "^0.38.0",
    "events": "^3.3.0",
    "fast-deep-equal": "^3.1.3",
    "genversion": "^3.2.0",
    "geojson-validation": "^1.0.2",
    "jszip": "^3.10.1",
    "multiformats": "13.4.2",
    "p-queue": "^9.0.0",
    "p-retry": "^8.0.0",
    "rimraf": "^6.1.3",
    "tiny-typed-emitter": "^2.1.0",
    "uint8arrays": "^6.0.0",
    "wherearewe": "^2.0.1"
  }
}
